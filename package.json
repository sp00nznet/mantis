{
  "name": "mantis-code",
  "version": "3.6.0",
  "description": "Agentic coding CLI — local or cloud LLMs, autonomous & swarm modes, Anthropic-compatible proxy, chat bots",
  "bin": {
    "mantis": "./bin/mantis.js"
  },
  "scripts": {
